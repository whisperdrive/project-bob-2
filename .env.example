# Copy to .env (git-ignored) and fill in from your Azure AI Foundry project's overview page.
AZURE_OPENAI_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1
AZURE_AI_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
# Only needed when signing in with a personal Microsoft account (e.g. <name>.onmicrosoft.com)
AZURE_TENANT_ID=
# Optional: dictation in Ask. An Azure Speech resource (Free F0 tier: 5 audio hours a month), Keys and Endpoint page:
# KEY 1, and the Endpoint (or the Location/Region)
SPEECH_KEY=
SPEECH_ENDPOINT=
# SPEECH_REGION=
# SPEECH_LANGUAGE=en-AU
# Optional: how long a model call may take before it's tried again (seconds, default 300), and how many more tries
# LLM_READ_TIMEOUT=300
# LLM_MAX_RETRIES=2
